{
  "name": "gitcraque",
  "version": "0.2.0",
  "type": "module",
  "description": "Cliente Git de desktop sem Electron: grafo de historico, drag-and-drop semantico e rebase interativo automatizado — backend Node.js puro servindo uma SPA React em localhost",
  "keywords": [
    "git",
    "git-gui",
    "git-client",
    "git-graph",
    "commit-graph",
    "version-control",
    "rebase",
    "cherry-pick",
    "worktree",
    "cli",
    "no-electron",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Frederico Kluser (https://github.com/frederico-kluser)",
  "homepage": "https://github.com/frederico-kluser/GitCraque#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frederico-kluser/GitCraque.git"
  },
  "bugs": {
    "url": "https://github.com/frederico-kluser/GitCraque/issues"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "server/bin",
    "server/src",
    "web/dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "node server/bin/gitcraque.mjs",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npm run test:server && npm run test:graph && npm run test:dnd && npm run test:viewer",
    "test:server": "node --test \"server/test/*.test.mjs\"",
    "test:graph": "node web/src/graph/__tests__/run.mjs",
    "test:dnd": "node --test \"web/src/dnd/__tests__/*.test.mjs\"",
    "test:viewer": "node --test \"web/src/viewer/__tests__/*.test.mjs\"",
    "test:e2e": "node scripts/verify-e2e.mjs",
    "prepack": "npm run build && node -e \"require('node:fs').statSync('web/dist/index.html')\""
  },
  "bin": {
    "gitcraque": "server/bin/gitcraque.mjs"
  }
}
