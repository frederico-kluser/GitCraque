{
  "$comment": "Deterministic enforcement for the knowledge-skill system. The scripts live in .agents/hooks/ so they stay portable across harnesses; this file is only the Claude Code glue. See .agents/README.md for what each gate does and how to remove it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/hooks/skill-write-gate.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/hooks/security-guard.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/hooks/bootstrap-stop.mjs\""
          }
        ]
      }
    ]
  }
}
